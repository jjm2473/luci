{% include('header') %}

<div id="view">
	<div class="spinning">{{ _('Loading view…') }}</div>
	<script>
		L.require('ui').then(function(ui) {
			ui.instantiateView('{{ view }}', {% if (resource_version): %}'{{ resource_version }}'{% else %}undefined{% endif %});
		});
	</script>
</div>

{% include('footer') %}
